{
  "name": "simple-websocket-chat",
  "version": "26.2.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && npm run start",
    "docker:build": "node -e \"const v=require('./package.json').version; require('child_process').execSync(`docker build -t harbor.imthespyke.fr/poggroup-public/quickord:${v} .`, {stdio:'inherit'})\"",
    "docker:push": "npm run docker:build && node -e \"const v=require('./package.json').version; require('child_process').execSync(`docker push harbor.imthespyke.fr/poggroup-public/quickord:${v}`, {stdio:'inherit'})\"",
    "docker:push:latest": "docker build -t harbor.imthespyke.fr/poggroup-public/quickord:latest . && docker push harbor.imthespyke.fr/poggroup-public/quickord:latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImSpyke/simple-websocket-chat.git"
  },
  "keywords": [],
  "author": "ImTheSpyke",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ImSpyke/simple-websocket-chat/issues"
  },
  "homepage": "https://github.com/ImSpyke/simple-websocket-chat#readme",
  "dependencies": {
    "express": "^4.21.2",
    "seedable-random-avatar-generator": "^1.1.2",
    "socket.io": "^4.8.1",
    "somefunctions": "^5.0.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "typescript": "^5.8.2"
  }
}
